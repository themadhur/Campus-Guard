rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'madhurnous@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName', 'email', 'role']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 100 &&
        data.role in ['student', 'staff', 'admin'];
    }

    function isValidComplaint(data) {
      return data.keys().hasAll([
        'complaintId', 'issueTitle', 'description', 'category',
        'urgency', 'department', 'building', 'floor', 'roomArea', 'status'
      ]) &&
      data.complaintId is string && data.complaintId.size() <= 32 &&
      data.issueTitle is string && data.issueTitle.size() > 0 && data.issueTitle.size() <= 150 &&
      data.description is string && data.description.size() > 0 && data.description.size() <= 2000 &&
      data.category is string && data.category.size() <= 50 &&
      data.urgency in ['Low', 'Medium', 'High', 'Critical'] &&
      data.department is string && data.department.size() <= 100 &&
      data.building is string && data.building.size() <= 100 &&
      data.floor is string && data.floor.size() <= 50 &&
      data.roomArea is string && data.roomArea.size() <= 100 &&
      data.status in ['Submitted', 'Under Review', 'Assigned', 'In Progress', 'Resolved', 'Closed', 'Rejected'];
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && (isOwner(userId) || isAdmin()) && isValidUserProfile(incoming());
      allow update: if isValidId(userId) && (isOwner(userId) || isAdmin()) && isValidUserProfile(incoming());
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Complaints collection
    match /complaints/{complaintDocId} {
      allow get: if isValidId(complaintDocId);
      // Admin can list all, students can list their own reports
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(complaintDocId) && isValidComplaint(incoming());
      allow update: if isValidId(complaintDocId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow delete: if isValidId(complaintDocId) && isAdmin();
    }

    match /admins/{adminId} {
      allow read, write: if isValidId(adminId) && isAdmin();
    }
  }
}
